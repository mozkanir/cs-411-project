flowchart LR
    VW["👤 Viewer"]
    US["👤 User<br/>(end user, application developer)"]
    AD["👤 Admin<br/>(server owner, model publisher)"]
    LU["👤 Local user<br/>(shell on the server machine)"]
    CL["API Client<br/>(curl / OpenAI SDK / ollama-python)"]
    REG["🗄️ Ollama Registry<br/>(external system)"]

    US -. "is a" .-> VW
    AD -. "is a" .-> US

    subgraph GW["IAM Gateway (new)"]
        direction TB
        G1(["Manage own account<br/>(sign in, password, API keys)"])
        G2(["Manage users, roles<br/>and audit log"])
        G3(["Authenticate API key<br/>and check role"])
    end

    subgraph SR["Smart Router (new, inside the gateway)"]
        direction TB
        R1(["Chat with automatic<br/>model selection (model: auto)"])
        R2(["Select model<br/>for the request"])
        R3(["Fall back to<br/>alternative model"])
        R4(["Configure routing rules<br/>and routable models"])
        R5(["View routing decisions<br/>and statistics"])
    end

    subgraph API["Ollama API (reached through the gateway)"]
        direction TB
        UC1(["List, show and see<br/>loaded models"])
        UC2(["Generate, chat or embed<br/>(native, OpenAI or Anthropic API)"])
        UC7(["Stop a loaded model"])
        UC3(["Manage models<br/>(pull, push, create, delete)"])
    end

    subgraph SYS["Ollama (local only)"]
        direction TB
        UC4(["Run a model in chat<br/>(ollama CLI, bypasses the gateway)"])
        UC5(["Load model on best device"])
    end

    VW --- G1
    VW --- UC1
    US --- UC2
    US --- UC7
    US --- R1
    AD --- G2
    AD --- UC3
    AD --- R4
    AD --- R5
    CL --- G3
    LU --- UC4
    UC3 --- REG

    API -. "«include»" .-> G3
    R1 -. "«include»" .-> R2
    R1 -. "«include»" .-> UC2
    R3 -. "«extend»" .-> R1
    UC2 -. "«include»" .-> UC5
    UC4 -. "«include»" .-> UC5
