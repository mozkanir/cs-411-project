flowchart LR
    subgraph CLIENTS["«device» Client machines (team members)"]
        browser["Web browser<br/>(gateway console)"]
        prog["Program with an API key<br/>(OpenAI SDK, ollama-python, curl)"]
    end

    subgraph PC["«device» Shared server (macOS / Windows / Linux)"]
        direction TB
        subgraph LCL["«execution environment» Local clients"]
            cli["ollama CLI"]
            desk["Ollama desktop app"]
            thirdp["Third-party app<br/>(IDE plugin, chat UI, script)"]
        end

        subgraph GWENV["«execution environment» Python runtime (uvicorn)"]
            gw["Ollama IAM Gateway<br/>0.0.0.0:8080 (IAM_HOST, IAM_PORT)<br/>auth → policy → proxy → audit"]
        end

        subgraph RTENV["«execution environment» Smart Router (new)"]
            router["Smart Router<br/>chooses a model for model: auto,<br/>falls back on error<br/>(rules from router.yaml)"]
        end

        iamdb[("«artifact» iam.db (SQLite)<br/>users, sessions, API key hashes,<br/>audit log")]

        subgraph SRV["«execution environment» ollama serve"]
            api["HTTP API :11434<br/>(127.0.0.1 only)"]
            sch["Scheduler"]
            st["Model store and<br/>registry client"]
        end

        subgraph RUN["«execution environment» Runner processes (one per loaded model)"]
            r1["llama-server<br/>127.0.0.1:random port"]
            r2["ollama runner (MLX, same binary)<br/>127.0.0.1:random port"]
        end

        subgraph HW["«device» Accelerators"]
            gpu["GPU<br/>(CUDA / ROCm / Metal / Vulkan)"]
            cpu["CPU and RAM"]
        end

        disk[("«artifact» ~/.ollama/models<br/>manifests/ and blobs/")]
        key[("«artifact» ~/.ollama/id_ed25519")]
    end

    subgraph NET["«device» Internet"]
        reg["registry.ollama.ai<br/>(model registry)"]
        cloud["ollama.com<br/>(account, cloud models)"]
    end

    tls>"Production: put an HTTPS reverse proxy<br/>in front of port 8080 (IAM_COOKIE_SECURE=true)"]

    browser -- "HTTP(S) :8080 /iam/*<br/>session cookie" --> gw
    prog -- "HTTP(S) :8080 /api/*, /v1/*<br/>Authorization: Bearer olg_..." --> gw
    gw -- "read/write" --> iamdb
    gw -- "HTTP/NDJSON, loopback only" --> api
    gw -- "model: auto" --> router
    router -- "HTTP, loopback" --> api

    style RTENV fill:#e9f6ec,stroke:#3c9a5f
    cli -- "HTTP/NDJSON, loopback<br/>(bypasses the gateway)" --> api
    desk -- "HTTP/NDJSON, loopback<br/>(bypasses the gateway)" --> api
    api --- sch
    api --- st
    sch -- "start, stop, HTTP" --> r1
    sch -- "start, stop, HTTP" --> r2
    r1 --> gpu
    r1 --> cpu
    r2 --> gpu
    r1 -- "read weights" --> disk
    r2 -- "read weights" --> disk
    st -- "read/write" --> disk
    st -- "HTTPS (pull/push)" --> reg
    api -- "HTTPS, signed with key<br/>(cloud models)" --> cloud
    st -. "signs with" .-> key
    tls -.- gw
